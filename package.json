  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-gzh-publisher.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-gzh-publisher#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-gzh-publisher/issues"
  },
  "dsh": {
